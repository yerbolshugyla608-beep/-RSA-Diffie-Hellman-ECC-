dh_code = """import random

# Баршаға ортақ белгілі параметрлер (жай сан p және генератор g)
p, g = 23, 5

# 1. Алиса мен Боб өздерінің құпия сандарын таңдайды
a_private = random.randint(1, p - 1)
b_private = random.randint(1, p - 1)

# 2. Ашық кілттерді есептейді және желі арқылы алмасады
A_public = pow(g, a_private, p)  # Алиса Бобқа жібереді
B_public = pow(g, b_private, p)  # Боб Алисаға жібереді

# 3. Екі тарап ортақ құпия кілтті өз бетінше есептеп шығарады
alice_shared = pow(B_public, a_private, p)
bob_shared = pow(A_public, b_private, p)

print(f"Алиса есептеген кілт: {alice_shared}")
print(f"Боб есептеген кілт:   {bob_shared}")  # Екі мән толықтай бірдей!"""

