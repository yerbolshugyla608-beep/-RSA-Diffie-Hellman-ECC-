ecc_code = """from cryptography.hazmat.primitives.asymmetric import ec

# 1. Алиса мен Боб SECP256R1 эллипстік қисығында кілт жұптарын генерациялайды
alice_private_key = ec.generate_private_key(ec.SECP256R1())
bob_private_key = ec.generate_private_key(ec.SECP256R1())

# 2. Ашық кілттерді алу
alice_public_key = alice_private_key.public_key()
bob_public_key = bob_private_key.public_key()

# 3. ECDH хаттамасы арқылы ортақ құпия кілтті есептеу
alice_shared_key = alice_private_key.exchange(ec.ECDH(), bob_public_key)
bob_shared_key = bob_private_key.exchange(ec.ECDH(), alice_public_key)

print(f"Алиса кілті (hex): {alice_shared_key.hex()[:24]}...")
print(f"Боб кілті (hex):   {bob_shared_key.hex()[:24]}...")"""

