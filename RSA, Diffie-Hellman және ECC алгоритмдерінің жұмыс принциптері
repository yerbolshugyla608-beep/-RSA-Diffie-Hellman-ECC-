rsa_code = """# RSA Математикалық моделі

p, q = 61, 53
n = p * q                # Модуль: n = 3233
phi = (p - 1) * (q - 1)  # Эйлер функциясы: phi = 3120

e = 17                   # Ашық кілт экспонентасы
d = pow(e, -1, phi)      # Жабық кілт экспонентасы (d = 2753)

message = 42             # Бастапқы сан түріндегі хабарлама

# Шифрлау: C = (M ^ e) % n
ciphertext = pow(message, e, n)
print(f"Шифрланған хабарлама: {ciphertext}")  # Шығыс: 2557

# Дешифрлау: M = (C ^ d) % n
decrypted = pow(ciphertext, d, n)
print(f"Дешифрланған хабарлама: {decrypted}")  # Шығыс: 42"""

