def set_slide_background(slide):
    background = slide.background
    fill = background.fill
    fill.solid()
    fill.fore_color.rgb = COLOR_BG


def add_header(slide, title_text, category_text=""):
    if category_text:
        cat_box = slide.shapes.add_textbox(
            Inches(0.8), Inches(0.4), Inches(11.7), Inches(0.4)
        )
        tf_c = cat_box.text_frame
        tf_c.word_wrap = True
        p_c = tf_c.paragraphs[0]
        p_c.text = category_text.upper()
        p_c.font.size = Pt(10)
        p_c.font.bold = True
        p_c.font.color.rgb = COLOR_ACCENT

    title_top = Inches(0.7) if category_text else Inches(0.5)
    title_box = slide.shapes.add_textbox(
        Inches(0.8), title_top, Inches(11.7), Inches(0.8)
    )
    tf = title_box.text_frame
    tf.word_wrap = True
    p = tf.paragraphs[0]
    p.text = title_text
    p.font.size = Pt(24)
    p.font.bold = True
    p.font.color.rgb = COLOR_PRIMARY


def add_code_block(slide, code_text, left, top, width, height):
    shape = slide.shapes.add_shape(
        MSO_SHAPE.ROUNDED_RECTANGLE, left, top, width, height
    )
    shape.fill.solid()
    shape.fill.fore_color.rgb = COLOR_CODE_BG
    shape.line.color.rgb = COLOR_CODE_BG

    tf = shape.text_frame
    tf.word_wrap = True
    tf.margin_left = Inches(0.2)
    tf.margin_right = Inches(0.2)
    tf.margin_top = Inches(0.2)
    tf.margin_bottom = Inches(0.2)

    p = tf.paragraphs[0]
    p.text = code_text
    p.font.size = Pt(11)
    p.font.name = "Consolas"
    p.font.color.rgb = COLOR_CODE_TEXT


